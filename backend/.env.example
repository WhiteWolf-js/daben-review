# Claude:自建 / 中转的 Anthropic 兼容网关
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-opus-4-8

# akshare 降频(规避东财 push2 限频)
AK_THROTTLE=1.2
AK_RETRIES=3
AK_BACKOFF=1.5

# 盘中监控通知(主用):飞书自建应用 SDK,可私聊推送本人
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TARGET=            # 推送目标:open_id(ou_ 开头=私聊本人)或群 chat_id(oc_ 开头)
# 备用:自定义机器人 webhook(只能发机器人所在群,无需应用凭证)
FEISHU_WEBHOOK=

# 交互式机器人(私聊发「复盘/候选/情绪/持仓/帮助」查盘,其余文本走 agent 自由提问)
# 需在开放平台给应用加「机器人」能力 + 事件订阅选「长连接接收」+ 订阅 im.message.receive_v1,并重新发布版本
FEISHU_BOT_ENABLED=0
# 白名单:本应用下的 open_id(ou_ 开头,非 union_id)。留空=只记日志不回复。
# 拿法:先启动 bot 用手机发一条消息,tail data/logs/bot.log 里会打印 sender open_id
FEISHU_BOT_ALLOW=
MONITOR_INTERVAL=90

# 成本估算:美元→人民币汇率(agent 调用成本按 Opus 4.8 官方单价估算,详见 agent/pricing.py)
USD_CNY=7.2
